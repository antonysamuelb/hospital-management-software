# Auto detect text files and perform LF normalization
* text=auto

# Force LF regardless of local checkout settings — these files run on Linux
# VMs (shebangs break with CRLF) or are parsed by systemd/nginx, which don't
# tolerate stray \r characters.
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.py text eol=lf
