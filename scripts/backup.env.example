# Copy to scripts/backup.env and fill in (backup.env is gitignored — don't
# commit real values, this is a template only).

GNUHEALTH_DATABASE=ghprod
BACKUP_DIR=/opt/gnuhealth/backups
# rclone remote name:bucket — configure the remote first with `rclone config`
# (Backblaze B2 application key, NOT your master account key).
RCLONE_REMOTE=b2backup:hospital-backups
